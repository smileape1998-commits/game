{
  "name": "hamster-coup-golden-acorns",
  "version": "1.0.0",
  "private": true,
  "description": "Hamster Coup: Golden Acorns - A strategic bluffing and faction card game for web browsers",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev --workspace=@hamster-coup/server",
    "dev:web": "npm run dev --workspace=@hamster-coup/web",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@hamster-coup/server",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
